# Flecha dev build on Linux: component build, so a change relinks one small library.
# build.sh writes this to out/Dev/args.gn on the first build.
is_debug = false
is_component_build = true
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "x64"
proprietary_codecs = true
ffmpeg_branding = "Chrome"
use_remoteexec = false
treat_warnings_as_errors = false
