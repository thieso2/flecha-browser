# Flecha release build on Linux: what package-release-linux.sh packs. build-release.sh
# writes this to out/Release/args.gn (FLECHA_OFFICIAL=1 adds is_official_build).
is_debug = false
is_component_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "x64"
# No H.264/AAC: shipping Chrome's proprietary codecs needs patent licences we don't have.
proprietary_codecs = false
use_remoteexec = false
# Our patches shouldn't fail a multi-hour build over a warning.
treat_warnings_as_errors = false
# No PGO profiles in this checkout (they come with checkout_pgo_profiles).
chrome_pgo_phase = 0
# The shell, staged into the checkout by build-release.sh, goes beside the executable as
# resources/flecha-shell (patch 0063).
flecha_shell_dir = "//flecha/shell"
