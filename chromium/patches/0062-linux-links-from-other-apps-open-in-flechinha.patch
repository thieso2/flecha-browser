+// Flecha: links from other apps (xdg-open, `flecha <url>`) reach the running
+// browser here; they open in a Flechinha while Flecha's window is up, as
+// app_controller_mac.mm does on macOS. Returns whether they did.
+bool OpenLinksInFlechinha(const base::CommandLine& command_line,
+                          const base::FilePath& current_directory,
+                          const StartupProfilePathInfo& profile_path_info) {
+  if (profile_path_info.mode != StartupProfileMode::kBrowserWindow ||
+      command_line.HasSwitch(switches::kIncognito) ||
+      command_line.HasSwitch(switches::kOpenInNewWindow) ||
+      command_line.HasSwitch(switches::kApp) ||
+      command_line.HasSwitch(switches::kAppId)) {
+    return false;
+  }
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(
+      profile_path_info.path);
+  if (!profile) {
+    return false;
+  }
+  const StartupTabs tabs = StartupTabProviderImpl().GetCommandLineTabs(
+      command_line, current_directory, profile);
+  if (tabs.empty() ||
+      std::ranges::any_of(tabs, &StartupTab::is_untrusted_launch)) {
+    return false;
+  }
+  // Whether links open in a Flechinha is the same for every link, so the
+  // first one decides for the rest.
+  if (!extensions::MaybeOpenLinkInFlechinha(profile, tabs.front().url)) {
+    return false;
+  }
+  for (size_t i = 1; i < tabs.size(); ++i) {
+    extensions::MaybeOpenLinkInFlechinha(profile, tabs[i].url);
+  }
+  return true;
+}
+#endif  // BUILDFLAG(IS_LINUX)
