diff --git a/chrome/common/chrome_paths.cc b/chrome/common/chrome_paths.cc
--- a/chrome/common/chrome_paths.cc
+++ b/chrome/common/chrome_paths.cc
@@ -479,8 +479,10 @@
       cur = base::FilePath(FILE_PATH_LITERAL(
           "/etc/opt/chrome_for_testing/native-messaging-hosts"));
 #else
+      // Flecha: its own folder, so its package registers the native host
+      // for every user without touching Chromium's.
       cur = base::FilePath(
-          FILE_PATH_LITERAL("/etc/chromium/native-messaging-hosts"));
+          FILE_PATH_LITERAL("/etc/flecha/native-messaging-hosts"));
